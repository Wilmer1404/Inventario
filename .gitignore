# ==========================================
# Patrimonio Marcona - Monorepo .gitignore
# ==========================================

# Dependencies
node_modules/
vendor/
.pnp
.pnp.js

# Environment variables
.env
.env.backup
.env.production
.env.local
.env.*.local
*.env

# Build outputs & caches
dist/
build/
out/
.next/
.expo/
.expo-shared/
web-build/
*.tsbuildinfo

# Logs & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log
logs/

# Laravel Storage & Cache
backend/storage/*.key
backend/storage/framework/cache/*
!backend/storage/framework/cache/.gitkeep
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitkeep
backend/storage/framework/testing/*
!backend/storage/framework/testing/.gitkeep
backend/storage/framework/views/*
!backend/storage/framework/views/.gitkeep
backend/storage/logs/*
!backend/storage/logs/.gitkeep
backend/bootstrap/cache/*
!backend/bootstrap/cache/.gitkeep

# Bienes uploaded files (preserve .gitkeep)
backend/storage/app/public/bienes/*
!backend/storage/app/public/bienes/.gitkeep

# SQLite database files for local dev
backend/database/*.sqlite
backend/database/*.sqlite-journal

# Editor and OS files
.DS_Store
Thumbs.db
.idea/
.vscode/
.claude/
*.swp
*.swo
*~
.phpunit.result.cache
